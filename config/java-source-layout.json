{
  "packageLimit": 8,
  "mavenModules": [
    "rentz-lab-app/game-core",
    "atf-tests"
  ],
  "excludedTrees": [
    ".git",
    ".idea",
    "reference-tests",
    "atf-tests/target",
    "rentz-lab-app/game-core/target",
    "rentz-lab-app/build",
    "rentz-lab-app/app/build",
    "rentz-lab-app/game-core/build",
    "rentz-lab-app/.gradle",
    "rentz-lab-app/algorithm-build/.gradle"
  ],
  "roots": [
    {
      "path": "rentz-lab-app/game-core/src/main/java",
      "role": "main",
      "forbidden": [
        "android",
        "ro.rentzlab.app",
        "org.junit",
        "atf.testkit",
        "atf.reporting",
        "ro.rentzlab.testing",
        "ro.rentzlab.app.testing"
      ]
    },
    {
      "path": "rentz-lab-app/game-core/src/test/java",
      "role": "test",
      "forbidden": []
    },
    {
      "path": "rentz-lab-app/app/src/main/java",
      "role": "main",
      "forbidden": [
        "org.junit",
        "atf.testkit",
        "atf.reporting",
        "ro.rentzlab.testing",
        "ro.rentzlab.app.testing"
      ]
    },
    {
      "path": "rentz-lab-app/app/src/test/java",
      "role": "test",
      "forbidden": []
    },
    {
      "path": "atf-tests/src/main/java",
      "role": "main",
      "forbidden": [
        "android"
      ]
    },
    {
      "path": "atf-tests/src/test/java",
      "role": "test",
      "forbidden": []
    },
    {
      "path": "atf-tests/tools",
      "role": "tools",
      "forbidden": []
    }
  ],
  "productionBoundaries": [
    {
      "package": "ro.rentzlab.core",
      "forbidden": [
        "ro.rentzlab.ai"
      ]
    }
  ],
  "externalNonTestBases": [
    "atf.testkit.assertions.ComponentAuditExtension.Publication",
    "org.junit.platform.launcher.TestExecutionListener",
    "org.junit.rules.TestRule"
  ]
}

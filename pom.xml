<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>atf.api</groupId>
  <artifactId>atf-rentz</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ATF Rentz</name>
  <description>Component testing and independent Android Rentz laboratory</description>
  <modules>
    <module>atf-test-kit</module>
    <module>rentz-lab-app/game-core</module>
    <module>atf-tests</module>
  </modules>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.0</junit.version>
    <jackson.version>2.17.2</jackson.version>
    <atf.consumer.profile>android</atf.consumer.profile>
    <atf.core.version>1.0.0-c3</atf.core.version>
    <atf.reporting.version>1.0.0-j20</atf.reporting.version>
    <atf.console.version>1.0.0-c1</atf.console.version>
    <atf.mock.version>1.0.0-m1</atf.mock.version>
    <atf.test.heap.max>1g</atf.test.heap.max>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>bootstrap-core-library</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <file>${maven.multiModuleProjectDirectory}/lib/atf-core-${atf.core.version}.jar</file>
              <pomFile>${maven.multiModuleProjectDirectory}/lib/atf-core-${atf.core.version}.pom</pomFile>
              <generatePom>false</generatePom>
            </configuration>
          </execution>
          <execution>
            <id>bootstrap-reporting-library</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <file>${maven.multiModuleProjectDirectory}/lib/atf-reporting-${atf.reporting.version}.jar</file>
              <pomFile>${maven.multiModuleProjectDirectory}/lib/atf-reporting-${atf.reporting.version}.pom</pomFile>
              <generatePom>false</generatePom>
            </configuration>
          </execution>
          <execution>
            <id>bootstrap-console-library</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <file>${maven.multiModuleProjectDirectory}/lib/atf-console-${atf.console.version}.jar</file>
              <pomFile>${maven.multiModuleProjectDirectory}/lib/atf-console-${atf.console.version}.pom</pomFile>
              <generatePom>false</generatePom>
            </configuration>
          </execution>
          <execution>
            <id>bootstrap-mock-library</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <file>${maven.multiModuleProjectDirectory}/lib/atf-mock-${atf.mock.version}.jar</file>
              <pomFile>${maven.multiModuleProjectDirectory}/lib/atf-mock-${atf.mock.version}.pom</pomFile>
              <generatePom>false</generatePom>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <workingDirectory>${project.basedir}</workingDirectory>
          <argLine>-Xms32m -Xmx${atf.test.heap.max} -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC</argLine>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <proc>none</proc>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>